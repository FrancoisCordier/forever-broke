// Cloudflare Worker that starts the `collect` workflow on time (ADR-0009).
// Deploy: see worker/README.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forever-broke-trigger",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "triggers": {
    // UTC. Every house's snapshot is stamped :21:43–:22:18 (A12): :24 gets it as early as possible, :39 is a
    // safety net for a late one (an unchanged snapshot is a 304). The only trigger of collect.yml.
    "crons": ["24 * * * *", "39 * * * *"]
  },
  "observability": { "enabled": true }
}
