// Cloudflare Worker that starts the `collect` workflow on time (ADR-0009).
// Deploy: see worker/README.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forever-broke-trigger",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "triggers": {
    // UTC. API snapshots refresh at ~:22: :29 catches it, :54 is a safety net. The only trigger of collect.yml.
    "crons": ["29 * * * *", "54 * * * *"]
  },
  "observability": { "enabled": true }
}
